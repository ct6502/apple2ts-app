{
  "name": "Apple2TS",
  "productName": "Apple2TS",
  "version": "1.6.3",
  "description": "Apple2TS for Desktop",
  "main": ".vite/build/main.js",
  "scripts": {
    "prestart": "npx tsx scripts/download-apple2ts.ts",
    "start": "electron-forge start",
    "prepackage": "npx tsx scripts/download-apple2ts.ts",
    "build:electron": "vite build --config vite.electron.config.mjs",
    "package": "npm run build:electron && electron-builder --config electron-builder.config.cjs --dir",
    "package:local": "npx tsx scripts/use-local-apple2ts.ts && npm run package",
    "premake": "npx tsx scripts/download-apple2ts.ts",
    "make": "npm run build:electron && electron-builder --config electron-builder.config.cjs",
    "make:unsigned": "SKIP_CODE_SIGNING=true npm run make",
    "prepublish": "npx tsx scripts/download-apple2ts.ts",
    "publish": "npm run build:electron && electron-builder --config electron-builder.config.cjs --publish always",
    "publish:unsigned": "SKIP_CODE_SIGNING=true npm run publish",
    "release": "./scripts/create-release.sh",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "keywords": [],
  "author": {
    "name": "CT6502",
    "email": "5461379+ct6502@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.9.0",
    "@electron-forge/maker-dmg": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.9.0",
    "@electron-forge/maker-zip": "^7.9.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.9.0",
    "@electron-forge/plugin-fuses": "^7.9.0",
    "@electron-forge/plugin-vite": "^7.9.0",
    "@electron-forge/publisher-github": "^7.9.0",
    "@electron/fuses": "^1.8.0",
    "@electron/notarize": "^3.1.0",
    "@electron/osx-sign": "^2.2.0",
    "@reforged/maker-appimage": "^5.2.0",
    "@types/electron-store": "^1.3.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "tsx": "^4.23",
    "typescript": "~5.9.3",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9"
  }
}
